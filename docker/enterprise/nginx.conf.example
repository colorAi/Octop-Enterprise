# Place map in nginx's http context; replace server_name and certificate paths.
map $http_upgrade $octop_connection { default upgrade; '' close; }
server {
    listen 443 ssl;
    server_name octop.example.com;
    ssl_certificate /etc/ssl/octop/fullchain.pem;
    ssl_certificate_key /etc/ssl/octop/privkey.pem;
    client_max_body_size 512m;
    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $octop_connection;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
