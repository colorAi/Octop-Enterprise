# Candidate budgets: two workers, two web processes, four server tool tasks; models unlimited by default.
OCTOP_RESOURCE_PROFILE=8g
COMPOSE_PROFILES=two-workers
OCTOP_WORKER_URLS={"runtime-worker":"http://worker:8088","runtime-worker2":"http://worker2:8088"}
OCTOP_WEB3_UPSTREAM=
OCTOP_PG_MEMORY=768m
OCTOP_IM_MEMORY=384m
OCTOP_WEB_MEMORY=320m
OCTOP_WORKER_MEMORY=1280m
OCTOP_SANDBOX_MEMORY=384m
OCTOP_SANDBOX_TOTAL_MEMORY=1536m
OCTOP_WEB_POOL_MAX=3
OCTOP_WORKER_POOL_MAX=6
OCTOP_IM_POOL_MAX_CONNS=12
