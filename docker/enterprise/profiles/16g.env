# Candidate budgets: three workers, three web processes, eight server tool tasks; models unlimited by default.
OCTOP_RESOURCE_PROFILE=16g
COMPOSE_PROFILES=three-workers
OCTOP_WORKER_URLS={"runtime-worker":"http://worker:8088","runtime-worker2":"http://worker2:8088","runtime-worker3":"http://worker3:8088"}
OCTOP_WEB3_UPSTREAM=server web3:8088;
OCTOP_PG_MEMORY=1536m
OCTOP_IM_MEMORY=512m
OCTOP_WEB_MEMORY=384m
OCTOP_WORKER_MEMORY=2048m
OCTOP_SANDBOX_MEMORY=512m
OCTOP_SANDBOX_TOTAL_MEMORY=4096m
OCTOP_WEB_POOL_MAX=4
OCTOP_WORKER_POOL_MAX=8
OCTOP_IM_POOL_MAX_CONNS=16
